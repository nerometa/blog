---
import { Image } from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt: string;
    size?: "full" | "medium" | "small";
}

const { src, alt, size = "full" } = Astro.props;

const sizeStyles = {
    full: "width: 100%; height: auto;",
    medium: "width: 50%; height: auto; display: block; margin: 0 auto;",
    small: "width: 33%; height: auto; display: block; margin: 0 auto;",
}[size];
---

<Image src={src} alt={alt} class={sizeStyles} />
